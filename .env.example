# ── Engine selection ──
# auto (default): Ollama if running → Sarvam if key → Claude if key → Mock
# mock | local | sarvam | claude
LAUNCHLENS_ENGINE=auto

# ── Remote LLM providers (optional) ──
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1

# ── Local LLM (Ollama) ──
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_DEFAULT_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_INDIC_MODEL=qwen2.5:3b-instruct-q4_K_M
OLLAMA_FAST_MODEL=gemma2:2b-instruct-q4_K_M

# ── Pricing (USD per 1M tokens) — used by cost preflight ──
SARVAM_INPUT_PRICE_PER_MTOK=0.50
SARVAM_OUTPUT_PRICE_PER_MTOK=1.50
CLAUDE_INPUT_PRICE_PER_MTOK=3.00
CLAUDE_OUTPUT_PRICE_PER_MTOK=15.00
COST_CONFIRM_THRESHOLD_USD=10.0

# ── DB (optional; MemoryStore defaults to in-memory) ──
POSTGRES_URL=
REDIS_URL=

# ── Data dirs ──
CENSUS_DATA_DIR=./data/raw/census
NFHS_DATA_DIR=./data/raw/nfhs
TRAI_DATA_DIR=./data/raw/trai
NSSO_DATA_DIR=./data/raw/nsso
DISTRICT_PROFILES_DIR=./data/processed/districts
CALIBRATION_DIR=./data/calibration

# ── Simulation defaults ──
DEFAULT_AGENT_COUNT=100
LLM_BATCH_SIZE=16
LLM_MAX_CONCURRENT_LOCAL=4
LLM_MAX_CONCURRENT_REMOTE=8

# ── Disk-backed response cache ──
CACHE_DIR=~/.launchlens/cache
CACHE_SIZE_LIMIT_GB=2.0

# ── External data (optional) ──
# DATAGOVINDIA_API_KEY=
# NSSO_RESOURCE_ID=
