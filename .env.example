# LLM APIs (hosted)
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1

# LLM (local — Ollama / llama.cpp / LM Studio, all OpenAI-compatible)
# When LOCAL_LLM_ENABLED=true, every route (Claude, Sarvam) is overridden to LOCAL.
LOCAL_LLM_ENABLED=false
LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:0.5b
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MAX_CONCURRENT=4

# DB (optional in dev — MemoryStore falls back to in-memory)
POSTGRES_URL=postgresql://user:pass@localhost:5432/launchlens
REDIS_URL=redis://localhost:6379/0

# Data
CENSUS_DATA_DIR=./data/raw/census
NFHS_DATA_DIR=./data/raw/nfhs
DISTRICT_PROFILES_DIR=./data/processed/districts

# Simulation
DEFAULT_AGENT_COUNT=1000
LLM_BATCH_SIZE=200
LLM_MAX_CONCURRENT=50
